{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OUTER_OPTICAL_FIELD_CONTRACT_V1.schema.json",
  "title": "REF_B Outer Optical Field Contract V1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "source",
    "frozenRegionReferences",
    "measuredTargets",
    "structures",
    "dynamicProperties",
    "acceptance",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "OUTER_OPTICAL_FIELD_CONTRACT_V1"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "P0_A_EXTRACTED_PENDING_INDEPENDENT_VALIDATION",
        "P0_A_PASS"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "refB",
        "p0_3ContractSha256",
        "roiMaskFreezeManifestSha256"
      ]
    },
    "frozenRegionReferences": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13
    },
    "measuredTargets": {
      "type": "object",
      "required": [
        "geometry",
        "colorMaterial",
        "depthOcclusion"
      ]
    },
    "structures": {
      "type": "array",
      "minItems": 1
    },
    "dynamicProperties": {
      "type": "object"
    },
    "acceptance": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "independentValidation": {
      "type": "object",
      "required": [
        "report",
        "status",
        "schemaSha256"
      ]
    }
  },
  "additionalProperties": false
}
